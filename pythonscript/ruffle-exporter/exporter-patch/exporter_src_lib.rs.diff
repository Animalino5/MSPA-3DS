 use crate::exporter::Exporter;
 use crate::progress::ExporterProgress;
 
+/// Which source-frame indices should be captured (and written to disk).
+#[derive(Debug, Clone)]
+enum CapturePlan {
+    /// Capture every frame from `skipframes` onward (streamed to disk).
+    /// `total` of `None` means "all frames" (use the movie header count).
+    From {
+        skipframes: u32,
+        total: Option<u32>,
+    },
+    /// Capture only the given indices; simulate from 0 up to the last index.
+    Indices {
+        indices: Vec<u32>,
+    },
+}
+
+impl CapturePlan {
+    fn should_capture(&self, i: u32) -> bool {
+        match self {
+            CapturePlan::From { skipframes, .. } => i >= *skipframes,
+            CapturePlan::Indices { indices, .. } => indices.binary_search(&i).is_ok(),
+        }
+    }
+
+}
+
+/// Parse a comma/whitespace-separated list of frame indices ("0,4,8,12").
+fn parse_frame_indices(spec: &str) -> Result<Vec<u32>> {
+    let mut indices = Vec::new();
+    for part in spec.split([',', '\n', '\r', ' ', '\t']) {
+        let part = part.trim();
+        if part.is_empty() {
+            continue;
+        }
+        let n: u32 = part
+            .parse()
+            .map_err(|e| anyhow!("Invalid frame index {part:?} in --frame-indices: {e}"))?;
+        if !indices.contains(&n) {
+            indices.push(n);
+        }
+    }
+    if indices.is_empty() {
+        return Err(anyhow!("--frame-indices produced no indices to capture"));
+    }
+    indices.sort_unstable();
+    Ok(indices)
+}
+
+/// Captures frames and streams them to disk as PNGs as they are rendered.
+///
+/// Unlike the original exporter (which accumulated every frame in memory and
+/// only wrote them at the end — OOMing on long movies), this writes each
+/// captured PNG immediately, keeping memory usage constant.
+///
+/// Files are named by their SOURCE frame index: `<output>/<index:0N>.png`,
+/// where N is the number of digits of the highest captured index.
+///
+/// Returns the number of frames written.
+fn take_screenshot_streaming(
+    exporter: &Exporter,
+    swf_path: &Path,
+    plan: &CapturePlan,
+    output_dir: &Path,
+    progress: &ExporterProgress,
+) -> Result<usize> {
+    let movie_export = exporter.start_exporting_movie(swf_path)?;
+
+    let totalframes = match plan {
+        CapturePlan::From {
+            total: Some(total),
+            ..
+        } => *total,
+        CapturePlan::From { total: None, .. } => movie_export.total_frames(),
+        CapturePlan::Indices { indices } => indices.last().copied().unwrap_or(0) + 1,
+    };
+    let digits = totalframes.to_string().len();
+
+    let mut written = 0usize;
+    for i in 0..totalframes {
+        progress.set_message(format!(
+            "{} frame {}",
+            swf_path.file_stem().unwrap().to_string_lossy(),
+            i
+        ));
+
+        movie_export.run_frame();
+
+        if plan.should_capture(i) {
+            match movie_export.capture_frame() {
+                Ok(image) => {
+                    let path = output_dir.join(format!("{i:0digits$}.png"));
+                    image.save(&path).map_err(|e| {
+                        anyhow!("Unable to write frame {i} to {}: {e}", path.display())
+                    })?;
+                    written += 1;
+                }
+                Err(e) => {
+                    return Err(anyhow!(
+                        "Unable to capture frame {} of {:?}: {:?}",
+                        i,
+                        swf_path,
+                        e
+                    ));
+                }
+            }
+        }
+
+        progress.inc(1);
+    }
+    Ok(written)
+}
